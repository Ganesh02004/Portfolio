# Local Docker development defaults.
#
# These values exist only inside the local Compose network. They are not
# secrets and must never be reused for a preview or production deployment.
# See .env.example for the full variable reference.

NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_owner_password
POSTGRES_DB=business_services

APP_DB_USER=app_user
APP_DB_PASSWORD=local_app_password

SESSION_COOKIE_SECRET=local-development-session-secret-change-before-deploying

DOWNLOAD_LINK_TTL_SECONDS=300
NEXT_PUBLIC_MAX_PRESENTATION_MB=4

FROM_EMAIL=no-reply@localhost.test
NOTIFICATION_EMAIL=team@localhost.test

DB_PORT=55432
WEB_PORT=3000
MAIL_UI_PORT=8025
MAIL_SMTP_PORT=1025
