# ---------------------------------------------------------------------------
# Business Services Platform — environment reference
#
# Copy to .env.docker for the local Docker stack, or set these as deployment
# environment variables. Never commit a file containing real credentials.
# Every variable below is validated at startup by src/lib/env.ts.
# ---------------------------------------------------------------------------

# Public base URL of the site. Used for canonical links and absolute URLs in
# email. Must include the scheme.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
#
# Two connections are required:
#   DATABASE_URL        the application login role. Holds no table privileges;
#                       every query selects a task role via SET LOCAL ROLE.
#   DATABASE_ADMIN_URL  the schema owner. Used only by migrations and the
#                       operational scripts in scripts/. Never used to serve
#                       a web request.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://app_user:change-me@localhost:5432/business_services
DATABASE_ADMIN_URL=postgres://postgres:change-me@localhost:5432/business_services

# Credentials the migration script provisions for the application login role.
APP_DB_USER=app_user
APP_DB_PASSWORD=change-me

# Set to "require" to force TLS to the database in production.
DATABASE_SSL_MODE=disable

# ---------------------------------------------------------------------------
# Sessions
#
# Used to sign the admin session cookie. Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this value invalidates every signed-in staff session.
# ---------------------------------------------------------------------------
SESSION_COOKIE_SECRET=

# Session lifetime in hours.
SESSION_TTL_HOURS=12

# ---------------------------------------------------------------------------
# Uploaded presentations
#
# Startup presentations are stored in PostgreSQL, in the startup_presentations
# table, written in the same transaction as the application they belong to.
# There is no object store, no bucket and no volume: the database is the only
# stateful resource this application needs.
#
# They are never publicly reachable. The only path to them is the
# authenticated route /api/admin/presentations, which requires a staff session
# AND a signed, expiring token.
# ---------------------------------------------------------------------------

# Lifetime of a staff download link, in seconds (30-3600).
DOWNLOAD_LINK_TTL_SECONDS=300

# Largest accepted presentation, in megabytes (1-64).
#
# The default of 4 exists because serverless platforms cap the request body —
# Vercel's limit is 4.5 MB — and a file the platform rejects never reaches the
# application, so the visitor would see a bare network error rather than a
# useful message. Raise it when self-hosting behind your own proxy.
#
# Presentations consume database storage, so check your provider's quota before
# raising this: a 0.5 GB free tier holds roughly 125 files at 4 MB each.
NEXT_PUBLIC_MAX_PRESENTATION_MB=4

# ---------------------------------------------------------------------------
# Email (SMTP)
#
# Local development points at Mailpit, which accepts everything and delivers
# nothing. Production requires a real provider plus sender-domain
# authentication (SPF/DKIM/DMARC) — see docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=no-reply@example.test
NOTIFICATION_EMAIL=team@example.test

# ---------------------------------------------------------------------------
# Abuse controls
#
# Fixed-window limits applied per client IP, stored in Postgres.
# ---------------------------------------------------------------------------
RATE_LIMIT_SUBMISSIONS_PER_HOUR=8
RATE_LIMIT_LOGIN_ATTEMPTS_PER_15_MIN=10

# ---------------------------------------------------------------------------
# Local Docker stack only (docker-compose.yml). Not read by the application.
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=business_services
DB_PORT=55432
WEB_PORT=3000
MAIL_UI_PORT=8025
